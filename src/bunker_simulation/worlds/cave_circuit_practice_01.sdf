<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8">
  <world name="cave_circuit_practice_01">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.01 0.01 0.01 1.0</ambient>
      <background>0.0 0.0 0.0 1.0</background>
      <grid>false</grid>
    </scene>

    <include>
      <name>starting_area</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cave Starting Area Type B</uri>
    </include>

    <include>
      <name>cave_tile_1</name>
      <pose>25 0 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cave Straight 01</uri>
    </include>

    <include>
      <name>cave_tile_2</name>
      <pose>50 0 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cave 3 Way 01</uri>
    </include>

    <include>
      <name>cave_tile_3</name>
      <pose>50 25 0 0 0 1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cave Corner 01</uri>
    </include>

    <include>
      <name>cave_tile_4</name>
      <pose>50 -25 0 0 0 -1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cave Straight 01</uri>
    </include>

    <include>
      <name>rock_fall_1</name>
      <pose>20 0 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Medium Rock Fall</uri>
    </include>

    <!-- ===== Demo artifacts (official DARPA SubT artifact models from Gazebo Fuel) ===== -->
    <!-- The robot starts at (0, 0) facing +x on the painted lane (see LANE below).
         Boulders, gravel and bricks are in the TRACK block below (scripts/generate_track.py). -->
    <!-- The survivor to find: DARPA SubT "Rescue Randy Sitting", just right of the lane
         (the lane is |y| < 0.9). COCO yolov8n detects him as `person`. -->
    <include>
      <name>survivor_randy</name>
      <pose>9.8 -1.3 0 0 0 1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy Sitting</uri>
    </include>

